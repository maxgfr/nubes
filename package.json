{
  "name": "nubes",
  "version": "1.0.0",
  "private": true,
  "description": "Your files in a GitHub repository you own: drag and drop in the browser, sync a folder from the terminal. No server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "engine": "bun scripts/engine.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src scripts test",
    "test:e2e": "bun run build && playwright test",
    "check-size": "bun scripts/check-size.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "age-encryption": "0.3.1",
    "fflate": "0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
